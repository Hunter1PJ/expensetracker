# Local Release Signing Credentials Template
# Copy this file to 'keystore.properties' (which is gitignored) and fill in your values.
# NEVER commit real passwords or keystore files to version control.

storeFile=/path/to/expense-tracker-upload-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=expensetracker-upload
keyPassword=YOUR_KEY_PASSWORD
